        "text": "=Original request:\n{{ $json.request }}\n\nProspects to evaluate:\n{{ $json.prospects }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the Qualification Sub-Agent of an AI-powered outbound sales system.\n\nYour task is to evaluate prospects returned by the Prospecting Agent and determine which ones should move forward to outreach.\n\nRULES:\n- Evaluate each prospect against ALL criteria from the original prospecting request.\n- Do not invent or assume missing information.\n- Check company fit, contact relevance, and data quality.\n- Give each prospect a score from 0–100.\n- Use:\n  - high: 80–100\n  - medium: 50–79\n  - low: 0–49\n- Only mark a prospect as high when there is strong evidence that it matches the requested criteria.\n- Explain the qualification briefly in \"reason\".\n- Preserve the original prospect data.\n- Do not perform new prospecting or use external tools.\n\nReturn only the structured output."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [48, 0],
      "id": "ec5823eb-f99f-4e36-bb77-e1f6d1bc09d1",
      "name": "Qualification Sub-Agent"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"qualified_prospects\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"company_name\": {\n            \"type\": \"string\"\n          },\n          \"website\": {\n            \"type\": \"string\"\n          },\n          \"contact_name\": {\n            \"type\": \"string\"\n          },\n          \"job_title\": {\n            \"type\": \"string\"\n          },\n          \"email\": {\n            \"type\": \"string\"\n          },\n          \"email_verified\": {\n            \"type\": \"boolean\"\n          },\n          \"qualification\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"high\",\n              \"medium\",\n              \"low\"\n            ]\n          },\n          \"score\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"maximum\": 100\n          },\n          \"reason\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"company_name\",\n          \"website\",\n          \"contact_name\",\n          \"job_title\",\n          \"email\",\n          \"email_verified\",\n          \"qualification\",\n          \"score\",\n          \"reason\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"qualified_prospects\"\n  ]\n}"
